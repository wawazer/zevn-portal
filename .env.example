# zevn.web.id — Environment Variables

# Upstash Redis (required for /api/license/* endpoints)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin secret for license management (/licenses page + admin API mutations)
ADMIN_SECRET=change-me-to-a-strong-random-string
